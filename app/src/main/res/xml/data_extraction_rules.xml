<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir credenciales cifradas con AndroidKeyStore (la llave privada no se transfiere entre dispositivos) -->
        <exclude domain="sharedpref" path="studycat_secure_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="studycat_secure_auth.xml" />
    </device-transfer>
</data-extraction-rules>